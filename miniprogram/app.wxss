/* 拾递 · 设计系统
   浅纸底 + 深绿主色 + 陶土色价格；所有尺寸用 rpx，一套 token 贯穿全端。 */
page {
  --bg: #f5f6f1;
  --surface: #ffffff;
  --surface-2: #eef1e8;
  --ink: #1d2a23;
  --ink-2: #55645a;
  --ink-3: #8b988f;
  --line: #e3e8dd;
  --brand: #24563f;
  --brand-2: #4c7a5f;
  --brand-soft: #e7efe4;
  --accent: #b56a35;
  --danger: #a9503f;
  --warn: #8a6a1f;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
view, text, button, input, textarea, picker, image, scroll-view { box-sizing: border-box; }

.page { padding: 24rpx 32rpx 0; min-height: 100vh; }
.page--bar { padding-bottom: 200rpx; }
.section-gap { height: 12rpx; }

/* ---------- 文字 ---------- */
.eyebrow { font-size: 20rpx; letter-spacing: 5rpx; color: var(--brand-2); text-transform: uppercase; margin-bottom: 14rpx; }
.h1 { font-size: 50rpx; line-height: 1.34; font-weight: 600; letter-spacing: -0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 600; line-height: 1.5; }
.h3 { font-size: 29rpx; font-weight: 600; }
.sub { font-size: 26rpx; color: var(--ink-2); line-height: 1.75; }
.muted { font-size: 24rpx; color: var(--ink-3); line-height: 1.7; }
.strong { font-weight: 600; }
.num { font-variant-numeric: tabular-nums; }
.link { color: var(--brand-2); font-size: 25rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- 布局 ---------- */
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row--start { display: flex; align-items: center; gap: 16rpx; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; min-width: 0; }
.hair { height: 1rpx; background: var(--line); margin: 24rpx 0; }
.mt8 { margin-top: 8rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; } .mt48 { margin-top: 48rpx; }
.gap8 { gap: 8rpx; } .gap12 { gap: 12rpx; } .gap16 { gap: 16rpx; }

/* ---------- 卡片 ---------- */
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 26rpx; padding: 30rpx; margin-bottom: 22rpx; }
.card--flat { background: var(--surface-2); border-color: transparent; }
.card__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.card__title { font-size: 30rpx; font-weight: 600; }
.card__hint { font-size: 22rpx; color: var(--ink-3); }

.hero { position: relative; overflow: hidden; background: linear-gradient(150deg, #e9f0e2 0%, #f3f6ec 55%, #eef2e6 100%); border-radius: 32rpx; padding: 44rpx 34rpx 38rpx; margin-top: 8rpx; }
.hero__mark { position: absolute; right: -26rpx; bottom: -40rpx; font-size: 220rpx; line-height: 1; color: rgba(36,86,63,.07); font-weight: 700; }
.hero .h1 { color: #1b3c2c; }
.hero .sub { color: #4a6353; margin-top: 14rpx; max-width: 460rpx; }

/* ---------- 按钮 ---------- */
.btn { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 500; padding: 0 28rpx; border: 0; margin: 0; flex-shrink: 0; white-space: nowrap; }
.btn::after { border: 0; }
.btn--primary { background: var(--brand); color: #fff; }
.btn--primary[disabled] { background: #b6c4ba; color: #f2f5f0; }
.btn--soft { background: var(--brand-soft); color: var(--brand); }
.btn--ghost { background: transparent; color: var(--ink-2); border: 1rpx solid var(--line); }
.btn--text { background: transparent; color: var(--brand-2); height: auto; padding: 8rpx 0; font-size: 26rpx; }
.btn--danger { background: #f7ece9; color: var(--danger); }
.btn--sm { height: 64rpx; font-size: 25rpx; border-radius: 14rpx; padding: 0 22rpx; }
.btn--block { width: 100%; }
.btn-row { display: flex; gap: 16rpx; }
.btn-row .btn { flex: 1; }

.link-btn { display: inline-flex; align-items: center; gap: 6rpx; background: transparent; padding: 0; margin: 0; font-size: 25rpx; color: var(--brand-2); line-height: 1.4; }
.link-btn::after { border: 0; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 26rpx; }
.field:last-child { margin-bottom: 0; }
.label { display: flex; align-items: baseline; justify-content: space-between; font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; }
.label__flag { font-size: 21rpx; color: var(--ink-3); font-weight: 400; }
.input, .textarea, .picker-box {
  width: 100%; background: #f7f8f3; border: 1rpx solid var(--line); border-radius: 16rpx;
  padding: 22rpx 24rpx; font-size: 27rpx; color: var(--ink); min-height: 90rpx; line-height: 1.5;
}
.textarea { height: 150rpx; padding-top: 20rpx; }
.picker-box { display: flex; align-items: center; justify-content: space-between; }
.picker-box__value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-box__caret { color: var(--ink-3); font-size: 22rpx; margin-left: 12rpx; }
.placeholder { color: #a8b3a9; }
.hint { font-size: 22rpx; color: var(--ink-3); margin-top: 10rpx; line-height: 1.6; }
.error-text { font-size: 22rpx; color: var(--danger); margin-top: 10rpx; }

/* ---------- 选择芯片 ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { padding: 16rpx 24rpx; border-radius: 14rpx; background: #f4f6ef; border: 1rpx solid var(--line); font-size: 25rpx; color: var(--ink-2); line-height: 1.35; }
.chip--on { background: var(--brand-soft); border-color: #9fbfa8; color: var(--brand); font-weight: 500; }
.chip--block { flex: 1; text-align: center; }

/* ---------- 状态 ---------- */
.pill { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 21rpx; background: var(--surface-2); color: var(--ink-2); line-height: 1.5; flex-shrink: 0; white-space: nowrap; }
.pill--pending { background: #fbf0e4; color: #96612c; }
.pill--progress { background: var(--brand-soft); color: var(--brand); }
.pill--done { background: #e9eee6; color: #6b7b6f; }
.pill--dead { background: #f2f2ee; color: #9b9f97; }

.price { font-size: 40rpx; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; }
.price--sm { font-size: 30rpx; }
.price__unit { font-size: 24rpx; font-weight: 500; margin-right: 2rpx; }

/* ---------- 底部固定栏 ---------- */
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  background: rgba(255,255,255,.96); border-top: 1rpx solid var(--line);
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(10rpx);
}
.footer-bar__inner { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.footer-bar .btn { min-width: 260rpx; }

/* ---------- 空态 / 加载 ---------- */
.loading-line { padding: 40rpx 0; text-align: center; font-size: 24rpx; color: var(--ink-3); }
.skeleton { background: linear-gradient(90deg, #eef1e9 25%, #f6f8f2 37%, #eef1e9 63%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; border-radius: 12rpx; }
@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

/* ---------- 列表 ---------- */
.list-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.list-item:last-child { border-bottom: 0; }
.list-item__icon { width: 68rpx; height: 68rpx; border-radius: 20rpx; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 30rpx; flex-shrink: 0; }
.list-item__body { flex: 1; min-width: 0; }
.list-item__title { font-size: 28rpx; font-weight: 500; }
.list-item__desc { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }
.list-item__caret { color: #b9c3b9; font-size: 26rpx; }

/* ---------- 图片上传 ---------- */
.uploader { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0 12rpx; }
.uploader__item { position: relative; width: 150rpx; height: 150rpx; border-radius: 16rpx; overflow: hidden; background: #f2f4ec; }
.uploader__img { width: 100%; height: 100%; }
.uploader__del {
  position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: rgba(29,42,35,.62); color: #fff; font-size: 20rpx; border-radius: 0 0 0 14rpx;
}
.uploader__add {
  width: 150rpx; height: 150rpx; border-radius: 16rpx; border: 1rpx dashed #cfd9cb; background: #fafbf6;
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8b988f;
}
.uploader__plus { font-size: 40rpx; line-height: 1; color: #9fb0a2; }
.uploader__label { font-size: 20rpx; margin-top: 8rpx; }

/* ---------- 同意勾选 ---------- */
.consent { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 28rpx; }
.consent__box {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 1rpx solid #cfd9cb; background: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; flex-shrink: 0; margin-top: 4rpx;
}
.consent__box--on { background: #24563f; border-color: #24563f; }
.consent__text { font-size: 23rpx; color: #6d7f6f; line-height: 1.65; flex: 1; }

/* ---------- 遮罩弹层 ---------- */
.mask { position: fixed; inset: 0; background: rgba(21,32,26,.42); z-index: 90; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; background: var(--surface); border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); max-height: 78vh; }
.sheet__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet__title { font-size: 32rpx; font-weight: 600; }
.sheet__close { font-size: 30rpx; color: var(--ink-3); padding: 8rpx 12rpx; }
.sheet__item { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 24rpx; border-radius: 18rpx; border: 1rpx solid var(--line); margin-bottom: 14rpx; background: #fbfcf8; }
.sheet__item--on { border-color: #9fbfa8; background: var(--brand-soft); }
