.sf { display: flex; align-items: flex-start; padding: 8rpx 0 4rpx; }
.sf__node { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; }
.sf__dot {
  width: 30rpx; height: 30rpx; border-radius: 50%; background: #fff;
  border: 2rpx solid #d8e0d3; display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 2; transition: all .2s;
}
.sf__tick { font-size: 18rpx; color: #fff; line-height: 1; }
.sf__label { margin-top: 12rpx; font-size: 21rpx; color: #a3aea4; line-height: 1.4; text-align: center; }
.sf__line { position: absolute; top: 15rpx; left: 50%; width: 100%; height: 2rpx; background: #e3e8dd; z-index: 1; }
.sf__line.is-done { background: #9fbfa8; }
.is-done .sf__dot { background: #24563f; border-color: #24563f; }
.is-done .sf__label { color: #4c7a5f; }
.is-current .sf__dot { border-color: #24563f; box-shadow: 0 0 0 6rpx rgba(36,86,63,.12); }
.is-current .sf__label { color: #1d2a23; font-weight: 600; }
