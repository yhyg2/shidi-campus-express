.sk-card { height: 220rpx; margin-top: 32rpx; }
.state-card { text-align: left; }
.state-card__icon {
  width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #f1f3e8; color: #8a6a1f;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-bottom: 20rpx;
}
.state-card__icon--ok { background: #e7efe4; color: #24563f; }
.state-card__icon--warn { background: #f7ece9; color: #a9503f; }
.code-input { letter-spacing: 3rpx; text-align: center; font-size: 32rpx; font-variant-numeric: tabular-nums; }
