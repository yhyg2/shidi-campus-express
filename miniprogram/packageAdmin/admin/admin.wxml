<view class="page page--bar">
  <view class="eyebrow">CAMPUS OPS</view>
  <view class="row">
    <view class="h1">校区管理台</view>
    <text wx:if="{{isStaff}}" class="pill pill--progress">{{roleLabel}}</text>
  </view>
  <view class="sub mt8">人员、定价、公告与订单。所有写操作都会记入操作日志。</view>

  <view wx:if="{{loading}}" class="loading-line">正在加载…</view>

  <empty-state wx:elif="{{!isStaff}}" icon="⊘" title="你还不是管理成员" desc="请联系现任管理员；首次部署需先由部署者指定初始化账号。" actionText="{{bootstrapable ? '初始化管理员' : ''}}" bind:action="bootstrap" />

  <block wx:else>
    <scroll-view class="tabs" scroll-x enable-flex show-scrollbar="{{false}}">
      <view wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'tab--on' : ''}}" data-id="{{item.id}}" bindtap="switchTab">{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{isLocal}}" class="muted admin-hint">本地演示模式：所有修改只保存在这台手机上。</view>

    <!-- ============ 概览 ============ -->
    <block wx:if="{{tab === 'overview'}}">
      <view class="stats-grid">
        <view class="stat-box"><text class="stat-box__num">{{stats.waiting}}</text><text class="stat-box__label">待接单</text></view>
        <view class="stat-box"><text class="stat-box__num">{{stats.active}}</text><text class="stat-box__label">进行中</text></view>
        <view class="stat-box"><text class="stat-box__num">{{stats.today}}</text><text class="stat-box__label">今日新增</text></view>
        <view class="stat-box"><text class="stat-box__num">{{stats.onlineRunners}}</text><text class="stat-box__label">在线代取</text></view>
      </view>

      <view class="card">
        <view class="row"><view class="h3">待处理</view><text class="muted">共 {{stats.pendingRunners}} 个代取待审核</text></view>
        <view class="hair"></view>
        <view class="row"><text class="muted">累计订单 {{stats.total}} · 已完成 {{stats.completed}} · 已取消 {{stats.cancelled}}</text></view>
        <view class="row mt16"><text class="muted">管理成员 {{stats.staff}} 人</text><text class="link" data-id="members" bindtap="switchTab">去管理 ›</text></view>
      </view>

      <view wx:if="{{complaints.length}}" class="card">
        <view class="card__head"><text class="card__title">待处理投诉</text><text class="card__hint">{{complaints.length}} 条</text></view>
        <view wx:for="{{complaints}}" wx:key="id" class="complaint-row">
          <view class="grow">
            <view class="row--start gap8">
              <text class="pill pill--dead">{{item.reasonLabel}}</text>
              <text class="muted">{{item.orderNo || item.orderId}}</text>
            </view>
            <view class="muted mt8">{{item.detail}}</view>
            <view class="muted">投诉人：{{item.ownerNickname || '同学'}} · {{item.timeText}}</view>
          </view>
          <button class="btn btn--soft btn--sm" data-id="{{item.id}}" bindtap="resolveComplaint">处理</button>
        </view>
      </view>

      <view class="sec-head"><text class="h2">最近订单</text><text class="link" data-id="orders" bindtap="switchTab">全部 ›</text></view>
      <view wx:if="{{!recent.length}}" class="muted">还没有订单。</view>
      <order-card wx:for="{{recent}}" wx:key="id" order="{{item}}" bind:open="openOrder" />

      <view class="sec-head"><text class="h2">操作日志</text></view>
      <view class="card">
        <view wx:if="{{!logs.length}}" class="muted">暂无记录。</view>
        <view wx:for="{{logs}}" wx:key="at" class="log-row">
          <text class="log-row__action">{{item.action}}</text>
          <text class="log-row__time">{{item.timeText}}</text>
        </view>
      </view>
    </block>

    <!-- ============ 订单 ============ -->
    <block wx:elif="{{tab === 'orders'}}">
      <view class="chips mt24">
        <view wx:for="{{orderFilters}}" wx:key="id" class="chip {{orderFilter === item.id ? 'chip--on' : ''}}" data-id="{{item.id}}" bindtap="filterOrders">{{item.label}}</view>
      </view>
      <view class="row mt8">
        <text class="muted grow">导出当前筛选的订单（最多 500 条，含联系电话）</text>
        <button class="btn btn--ghost btn--sm" bindtap="exportOrders" loading="{{busy}}" disabled="{{busy}}">导出 CSV</button>
      </view>
      <view wx:if="{{!orders.length}}" class="muted mt32">这个筛选下没有订单。</view>
      <view wx:for="{{orders}}" wx:key="id" class="card order-admin">
        <view class="row">
          <text class="h3">{{item.stationName}} → {{item.destination || item.room}}</text>
          <text class="pill pill--{{item.statusTone}}">{{item.statusText}}</text>
        </view>
        <view class="muted mt8">{{item.orderNo || item.id}} · {{item.parcelCount}} 件 · ¥{{item.amount}} · {{item.createText}}</view>
        <view class="muted">下单：{{item.ownerNickname || '同学'}} ｜ 代取：{{item.runnerName || '未分配'}}</view>
        <view wx:if="{{item.status === 'waiting_assignment'}}" class="order-admin__ops">
          <button class="btn btn--ghost btn--sm" data-id="{{item.id}}" bindtap="openOrder">详情</button>
          <button class="btn btn--soft btn--sm" data-id="{{item.id}}" bindtap="assign" disabled="{{busy}}">指派代取</button>
        </view>
        <view wx:else class="order-admin__ops">
          <button class="btn btn--ghost btn--sm" data-id="{{item.id}}" bindtap="openOrder">详情</button>
          <button wx:if="{{item.status !== 'completed' && item.status !== 'cancelled'}}" class="btn btn--danger btn--sm" data-id="{{item.id}}" bindtap="cancelOrder" disabled="{{busy}}">取消订单</button>
        </view>
      </view>
    </block>

    <!-- ============ 成员 ============ -->
    <block wx:elif="{{tab === 'members'}}">
      <view class="card mt24">
        <view class="row">
          <view class="grow">
            <view class="h3">邀请管理员</view>
            <view class="muted mt8">生成一次性邀请码，对方在「我的 → 加入运营团队」输入后成为管理员。</view>
          </view>
          <button class="btn btn--primary btn--sm" bindtap="inviteMember">生成管理员邀请码</button>
        </view>
        <view wx:if="{{newInvite}}" class="invite-box">
          <view class="muted">仅显示一次 · {{newInvite.roleLabel}} · 有效至 {{newInvite.expireText}}</view>
          <view class="invite-box__code">{{newInvite.code}}</view>
          <view class="btn-row mt16">
            <button class="btn btn--ghost btn--sm" bindtap="copyInvite">复制</button>
            <button class="btn btn--soft btn--sm" open-type="share">发给同学</button>
          </view>
        </view>
      </view>

      <view class="sec-head"><text class="h2">管理成员</text><text class="hint">成员 {{members.length}} 人</text></view>
      <view class="muted admin-tip">下单的同学都是「普通用户」，不需要在这里添加；这里只管理有后台权限的人。</view>
      <view wx:for="{{members}}" wx:key="id" class="card member">
        <view class="row">
          <view class="grow">
            <view class="h3">{{item.nickname}}</view>
            <view class="muted mt8">{{item.roleLabel}}{{item.joinedText ? ' · 加入于 ' + item.joinedText : ''}}</view>
          </view>
          <text class="pill {{item.role === 'superadmin' ? 'pill--pending' : 'pill--progress'}}">{{item.role === 'superadmin' ? '超管' : '成员'}}</text>
        </view>
        <view wx:if="{{item.role !== 'superadmin'}}" class="btn-row mt16">
          <button class="btn btn--danger btn--sm" data-id="{{item.id}}" data-name="{{item.nickname}}" bindtap="removeMember">移出管理团队</button>
        </view>
      </view>

      <view class="sec-head"><text class="h2">未使用的邀请码</text></view>
      <view class="card">
        <view wx:if="{{!memberInvites.length}}" class="muted">还没有生成过。</view>
        <view wx:for="{{memberInvites}}" wx:key="id" class="invite-row">
          <view class="grow">
            <view class="h3">{{item.code}}</view>
            <view class="muted">{{item.roleLabel}} · 有效至 {{item.expireText}}</view>
          </view>
          <text class="pill {{item.used ? 'pill--done' : 'pill--progress'}}">{{item.used ? '已使用' : '未使用'}}</text>
        </view>
      </view>
    </block>

    <!-- ============ 代取审核 ============ -->
    <block wx:elif="{{tab === 'runners'}}">
      <view class="card mt24">
        <view class="row">
          <view class="grow">
            <view class="h3">代取邀请码</view>
            <view class="muted mt8">发给想接单的同学，对方在「申请代取」里填写。</view>
          </view>
          <button class="btn btn--primary btn--sm" bindtap="makeRunnerInvite">生成</button>
        </view>
        <view wx:if="{{runnerInvite}}" class="invite-box">
          <view class="muted">{{runnerInvite.campusName}} · 有效至 {{runnerInvite.expireText}}</view>
          <view class="invite-box__code">{{runnerInvite.code}}</view>
          <view class="btn-row mt16">
            <button class="btn btn--ghost btn--sm" bindtap="copyRunnerInvite">复制</button>
            <button class="btn btn--soft btn--sm" open-type="share">发给同学</button>
          </view>
        </view>
      </view>

      <view wx:if="{{!runners.length}}" class="muted mt32">还没有同学提交代取认证。把上面的代取邀请码发给同学，他们提交后会出现在这里等你审核。</view>
      <view wx:for="{{runners}}" wx:key="id" class="card">
        <view class="row">
          <view class="grow">
            <view class="h3">{{item.realName || item.nickname}}</view>
            <view class="muted mt8">学号 {{item.studentNo}} · {{item.campusId}}{{item.online ? ' · 接单中' : ''}}</view>
          </view>
          <text class="pill {{item.status === 'approved' ? 'pill--progress' : item.status === 'pending' ? 'pill--pending' : 'pill--dead'}}">{{item.statusText}}</text>
        </view>
        <view wx:if="{{item.reason}}" class="muted mt8">备注：{{item.reason}}</view>
        <view class="btn-row mt16">
          <button wx:if="{{item.status === 'pending'}}" class="btn btn--primary btn--sm" data-id="{{item.id}}" data-decision="approved" data-name="{{item.nickname}}" bindtap="reviewRunner">通过</button>
          <button wx:if="{{item.status === 'pending'}}" class="btn btn--ghost btn--sm" data-id="{{item.id}}" data-decision="rejected" data-name="{{item.nickname}}" bindtap="reviewRunner">驳回</button>
          <button wx:if="{{item.status === 'approved'}}" class="btn btn--danger btn--sm" data-id="{{item.id}}" data-decision="suspended" data-name="{{item.nickname}}" bindtap="reviewRunner">暂停权限</button>
          <button class="btn btn--ghost btn--sm" data-value="{{item.studentNo}}" bindtap="copyStudentNo">复制学号</button>
        </view>
      </view>
    </block>

    <!-- ============ 定价 ============ -->
    <block wx:elif="{{tab === 'pricing'}}">
      <view wx:if="{{pricingForm}}" class="card mt24">
        <view class="card__head"><text class="card__title">基础规则</text><text class="card__hint">单位：元</text></view>
        <view class="field">
          <view class="label"><text>起步价</text><text class="label__flag">每单固定</text></view>
          <input class="input" type="digit" value="{{pricingForm.baseFeeYuan}}" data-field="baseFeeYuan" bindinput="priceInput" />
        </view>
        <view class="field">
          <view class="label"><text>计费方式</text></view>
          <view class="chips">
            <view class="chip {{pricingForm.chargeMode === 'perParcel' ? 'chip--on' : ''}}" bindtap="toggleChargeMode">按件计费（{{pricingForm.chargeMode === 'perParcel' ? '当前' : '切换'}}）</view>
            <view class="chip {{pricingForm.chargeMode === 'perOrder' ? 'chip--on' : ''}}">按单计费</view>
          </view>
          <view class="hint">按件：单价 × 件数；按单：只看尺寸单价，不看件数。</view>
        </view>
        <view class="field-row">
          <view class="field grow"><view class="label"><text>最低收费</text></view><input class="input" type="digit" value="{{pricingForm.minTotalYuan}}" data-field="minTotalYuan" bindinput="priceInput" /></view>
          <view class="field grow"><view class="label"><text>最高收费</text></view><input class="input" type="digit" value="{{pricingForm.maxTotalYuan}}" data-field="maxTotalYuan" bindinput="priceInput" /></view>
        </view>
        <view class="row mt16">
          <view class="grow"><text class="muted">距离计费暂未接入</text></view>
        </view>
      </view>

      <view wx:if="{{pricingForm}}" class="card">
        <view class="card__head"><text class="card__title">包裹尺寸</text><text class="card__hint">学生下单时选这个</text></view>
        <view wx:for="{{pricingForm.sizes}}" wx:key="id" class="size-row">
          <view class="grow">
            <view class="h3">{{item.label}}</view>
            <input class="input input--inline" value="{{item.hint}}" data-index="{{index}}" data-field="hint" bindinput="priceSizeInput" placeholder="尺寸说明" />
          </view>
          <view class="size-row__price">
            <text class="muted">¥</text>
            <input class="input input--price" type="digit" value="{{item.centsYuan}}" data-index="{{index}}" data-field="centsYuan" bindinput="priceSizeInput" />
          </view>
        </view>
      </view>

      <view wx:if="{{pricingForm}}" class="card">
        <view class="card__head"><text class="card__title">时段加价</text><text class="card__hint">可增删</text></view>
        <view wx:for="{{pricingForm.slots}}" wx:key="label" class="slot-row">
          <text class="grow">{{item.label}}</text>
          <text class="muted">+¥</text>
          <input class="input input--price" type="digit" value="{{item.surchargeYuan}}" data-index="{{index}}" bindinput="priceSlotInput" />
          <text class="slot-row__del" data-index="{{index}}" bindtap="removeSlot">✕</text>
        </view>
        <button class="btn btn--ghost btn--sm mt16" bindtap="addSlot">＋ 添加时段</button>
      </view>

      <view wx:if="{{pricingForm}}" class="card">
        <view class="field">
          <view class="label"><text>结算说明</text><text class="label__flag">展示在下单页</text></view>
          <textarea class="textarea" value="{{pricingForm.settleNote}}" data-field="settleNote" bindinput="priceInput" maxlength="120" />
          <view class="hint">平台不代收费用，这里写清线下结算方式，能减少纠纷。</view>
        </view>
      </view>

      <button wx:if="{{pricingForm}}" class="btn btn--primary btn--block mt16" bindtap="savePricing">保存价格</button>
    </block>

    <!-- ============ 公告 ============ -->
    <block wx:elif="{{tab === 'notice'}}">
      <button class="btn btn--primary btn--block mt24" bindtap="newNotice">＋ 发布公告</button>
      <view wx:if="{{!notices.length}}" class="muted mt32">还没有公告。</view>
      <view wx:for="{{notices}}" wx:key="id" class="card notice-admin">
        <view class="row">
          <view class="grow">
            <view class="row--start">
              <text wx:if="{{item.pinned}}" class="pill pill--pending">置顶</text>
              <text class="h3">{{item.title}}</text>
            </view>
            <view class="muted mt8">{{item.levelText}} · {{item.dateText}} · {{item.active === false ? '已下线' : '展示中'}}</view>
          </view>
        </view>
        <view class="notice-admin__body">{{item.content}}</view>
        <view class="btn-row mt16">
          <button class="btn btn--ghost btn--sm" data-id="{{item.id}}" bindtap="editNotice">编辑</button>
          <button class="btn btn--danger btn--sm" data-id="{{item.id}}" bindtap="removeNotice">删除</button>
        </view>
      </view>
    </block>

    <!-- ============ 设置 ============ -->
    <block wx:elif="{{tab === 'settings'}}">
      <view class="card mt24">
        <view class="card__head"><text class="card__title">客服联系方式</text><text class="card__hint">首页与订单页可见</text></view>
        <view class="field">
          <view class="label"><text>客服微信号</text><text class="label__flag">选填</text></view>
          <input class="input" value="{{contactDraft.wechatId}}" data-field="wechatId" bindinput="contactInput" maxlength="40" placeholder="例如 demo_service" />
          <view class="hint">只填微信号本身，不要带「微信：」前缀。用户点一下就能复制。</view>
        </view>
        <view class="field">
          <view class="label"><text>客服电话</text><text class="label__flag">选填</text></view>
          <input class="input" value="{{contactDraft.phone}}" data-field="phone" bindinput="contactInput" type="number" maxlength="20" placeholder="例如 10000000000" />
          <view class="hint">用户点击会直接拨号；不填就只显示微信。</view>
        </view>
      </view>

      <view class="card">
        <view class="card__head"><text class="card__title">派单与认证规则</text><text class="card__hint">影响学生端</text></view>
        <view class="row rule-row">
          <view class="grow"><view class="h3">提交后自动派单</view><view class="muted">关闭后订单只进入接单大厅</view></view>
          <view class="switch {{rulesDraft.autoDispatch ? 'switch--on' : ''}}" data-field="autoDispatch" bindtap="toggleRule"><view class="switch__dot"></view></view>
        </view>
        <view class="row rule-row">
          <view class="grow"><view class="h3">代取需在线才派单</view><view class="muted">关闭后仅按在手单量轮转</view></view>
          <view class="switch {{rulesDraft.requireRunnerOnline ? 'switch--on' : ''}}" data-field="requireRunnerOnline" bindtap="toggleRule"><view class="switch__dot"></view></view>
        </view>
        <view class="row rule-row">
          <view class="grow"><view class="h3">按距离优先</view><view class="muted">需要代取上报位置，否则按单量轮转</view></view>
          <text class="muted">暂未接入</text>
        </view>
        <view class="row rule-row">
          <view class="grow"><view class="h3">要求上传学生证</view><view class="muted">代取认证时必传证件照</view></view>
          <view class="switch {{rulesDraft.requireRunnerIdPhoto ? 'switch--on' : ''}}" data-field="requireRunnerIdPhoto" bindtap="toggleRule"><view class="switch__dot"></view></view>
        </view>
        <view class="field-row mt24">
          <view class="field grow"><view class="label"><text>取件开始</text></view><input class="input" value="{{rulesDraft.serviceStart}}" data-field="serviceStart" bindinput="ruleInput" placeholder="10:30" maxlength="5" /></view>
          <view class="field grow"><view class="label"><text>取件结束</text></view><input class="input" value="{{rulesDraft.serviceEnd}}" data-field="serviceEnd" bindinput="ruleInput" placeholder="21:30" maxlength="5" /></view>
        </view>
        <view class="hint">只有这段时间能去驿站取件；下单不受限制。格式 10:30。</view>

        <view class="field mt24">
          <view class="label"><text>接单超时（分钟）</text><text class="label__flag">超过即提醒代取</text></view>
          <input class="input" type="number" value="{{rulesDraft.staleMinutes}}" data-field="staleMinutes" bindinput="ruleInput" />
          <view class="hint">待接单订单等待超过该分钟数，会在大厅和首页提醒。</view>
        </view>
        <view class="field mt24">
          <view class="label"><text>同时在手订单上限</text></view>
          <input class="input" type="number" value="{{rulesDraft.maxActivePerRunner}}" data-field="maxActivePerRunner" bindinput="ruleInput" />
        </view>
        <view class="field-row">
          <view class="field grow"><view class="label"><text>代取邀请码有效小时</text></view><input class="input" type="number" value="{{rulesDraft.runnerInviteTtlHours}}" data-field="runnerInviteTtlHours" bindinput="ruleInput" /></view>
          <view class="field grow"><view class="label"><text>成员邀请码有效小时</text></view><input class="input" type="number" value="{{rulesDraft.memberInviteTtlHours}}" data-field="memberInviteTtlHours" bindinput="ruleInput" /></view>
        </view>
        <view class="field">
          <view class="label"><text>学号格式（字符集与长度）</text></view>
          <input class="input" value="{{rulesDraft.runnerStudentNoPattern}}" data-field="runnerStudentNoPattern" bindinput="ruleInput" />
          <view class="hint">默认 ^[A-Za-z0-9-]{4,24}$；10 位数字可用 ^[0-9]{10}$。</view>
        </view>
      </view>

      <view class="card">
        <view class="card__head"><text class="card__title">校区与网点</text><text class="card__hint">改完记得保存</text></view>
        <view wx:for="{{school.campuses}}" wx:for-item="campus" wx:for-index="ci" wx:key="id" class="campus-block">
          <view class="h3">{{campus.name}}</view>

          <view class="muted mt16">楼栋（可选，不配也行）</view>
          <view class="chips mt16">
            <view wx:for="{{campus.buildings}}" wx:for-item="b" wx:for-index="bi" wx:key="*this" class="chip chip--closable">
              <text>{{b}}</text>
              <text class="chip__x" data-index="{{ci}}" data-name="{{b}}" catchtap="removeBuilding">✕</text>
            </view>
            <view class="chip chip--add" data-index="{{ci}}" bindtap="addBuilding">＋ 楼栋</view>
          </view>
          <view wx:if="{{!campus.buildings.length}}" class="muted mt8">没配楼栋时，下单页只让同学填「送达地址」，不需要选楼栋。</view>

          <view class="muted mt24">驿站</view>
          <view wx:for="{{campus.stations}}" wx:for-item="s" wx:for-index="si" wx:key="id" class="station-row">
            <view class="grow"><view class="h3">{{s.name}}</view><view class="muted">{{s.openHours}}</view></view>
            <text class="slot-row__del" data-index="{{ci}}" data-id="{{s.id}}" catchtap="removeStation">✕</text>
          </view>
          <view class="chip chip--add mt16" data-index="{{ci}}" bindtap="addStation">＋ 驿站</view>
        </view>
      </view>

      <button class="btn btn--primary btn--block mt16" bindtap="saveSettings">保存设置</button>
    </block>

    <view class="admin__foot muted">拾递 v3 · 权限由服务端校验</view>
  </block>

  <block wx:if="{{noticeDraft}}">
    <view class="mask" bindtap="closeNoticeDraft"></view>
    <view class="sheet">
      <view class="sheet__head">
        <text class="sheet__title">{{noticeDraft.id ? '编辑公告' : '发布公告'}}</text>
        <text class="sheet__close" bindtap="closeNoticeDraft">✕</text>
      </view>
      <view class="field">
        <view class="label"><text>标题</text><text class="label__flag">{{noticeDraft.title.length}}/40</text></view>
        <input class="input" value="{{noticeDraft.title}}" data-field="title" bindinput="noticeInput" maxlength="40" placeholder="例如：国庆期间取件时间调整" />
      </view>
      <view class="field">
        <view class="label"><text>内容</text><text class="label__flag">{{noticeDraft.content.length}}/500</text></view>
        <textarea class="textarea sheet__textarea" value="{{noticeDraft.content}}" data-field="content" bindinput="noticeInput" maxlength="500" placeholder="写清时间、范围与影响" />
      </view>
      <view class="row">
        <view class="chips">
          <view class="chip {{noticeDraft.level === 'info' ? 'chip--on' : ''}}" data-value="info" bindtap="pickNoticeLevel">普通</view>
          <view class="chip {{noticeDraft.level === 'warn' ? 'chip--on' : ''}}" data-value="warn" bindtap="pickNoticeLevel">重要</view>
        </view>
        <view class="row--start gap16">
          <text class="muted">置顶</text>
          <view class="switch {{noticeDraft.pinned ? 'switch--on' : ''}}" data-field="pinned" bindtap="toggleNoticeFlag"><view class="switch__dot"></view></view>
        </view>
      </view>
      <button class="btn btn--primary btn--block mt24" bindtap="saveNotice">保存并发布</button>
    </view>
  </block>
</view>
