{
  "pages": [
    "pages/home/home",
    "pages/create/create",
    "pages/orders/orders",
    "pages/detail/detail",
    "pages/profile/profile",
    "pages/notice/notice",
    "pages/join/join",
    "pages/privacy/privacy",
    "pages/agreement/agreement"
  ],
  "subPackages": [
    { "root": "packageRunner", "name": "runner", "pages": ["runner/runner", "hall/hall", "apply/apply"] },
    { "root": "packageAdmin", "name": "admin", "pages": ["admin/admin"] }
  ],
  "preloadRule": {
    "pages/profile/profile": { "network": "all", "packages": ["runner"] }
  },
  "window": {
    "navigationBarTitleText": "拾递 · 校园代取",
    "navigationBarBackgroundColor": "#f5f6f1",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f6f1",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#8b988f",
    "selectedColor": "#24563f",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页", "iconPath": "images/tabbar/home.png", "selectedIconPath": "images/tabbar/home-active.png" },
      { "pagePath": "pages/orders/orders", "text": "订单", "iconPath": "images/tabbar/orders.png", "selectedIconPath": "images/tabbar/orders-active.png" },
      { "pagePath": "pages/profile/profile", "text": "我的", "iconPath": "images/tabbar/profile.png", "selectedIconPath": "images/tabbar/profile-active.png" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
